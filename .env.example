# Mercado Pago (servidor — nunca commitar token real)
MP_ACCESS_TOKEN=
# URL pública do site (opcional se já usar bmaxbrasiloficial.com.br no código; útil com www ou staging)
MP_SITE_URL=https://bmaxbrasiloficial.com.br
# Webhook de pagamentos (opcional)
# MP_NOTIFICATION_URL=https://bmaxbrasiloficial.com.br/api/webhooks

# Supabase (cliente publico; usar a anon key, nunca a service_role no browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase (somente servidor/API; opcional, mas recomendado para gravar cadastros de clientes)
SUPABASE_SERVICE_ROLE_KEY=
